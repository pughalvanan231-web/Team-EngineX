# Interview Agent Configuration Template
# LLM Provider: "groq" | "gemini" | "openai" | "demo"
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=20

# When true (or no API key present) the agent runs in demo mode
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*
DATABASE_DIR=backend/data/interviews
